{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(node:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Skill(*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/session-start.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/type-check.js\" \"${CLAUDE_TOOL_INPUT_FILE_PATH}\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/prettier-format.js\" \"${CLAUDE_TOOL_INPUT_FILE_PATH}\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/session-logger.js\" \"${CLAUDE_TOOL_NAME}\" \"${CLAUDE_TOOL_INPUT_FILE_PATH}\"",
            "timeout": 10000,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/suggest-compact.js\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/suggest-compact.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/git-push-review.js\" \"${CLAUDE_TOOL_INPUT_COMMAND}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/console-log-audit.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PWD}/.claude/scripts/hooks/memory-persist.js\""
          }
        ]
      }
    ]
  }
}
