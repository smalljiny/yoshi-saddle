# Harness 배포 산출물 — src/ 가 소스 원천, deploy-harness.sh 로 동기화
/.claude/
/.codex/
/.harness/

# 로컬 작업 문서 (개발 중 임시 파일)
docs/_local/

# wf-deep-research 자동 생성 리서치 보고서 (재생성 가능, 민감 내용 포함 가능)
docs/research/research-*.md

# 참조 자료 (외부 프로젝트, read-only)
/references/

# 의존성
node_modules/
dist/
.DS_Store

# 민감한 파일 (절대 커밋하지 않음)
.env
.env.*
*.pem
*.key
*.p12
credentials.json
*.token

# Dependency analysis reports
.deps-report.txt
.knip-report.json
AGENTS.md

# graphify Stage 1 — 출력 디렉토리 내부는 ignore, 사람이 읽는 요약과 사용량만 tracked
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/cost.json
